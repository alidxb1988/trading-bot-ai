# ─────────────────────────────────────────────────────────────────────────────
# Trading Bot AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-random-secret-key
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── Trading mode ──────────────────────────────────────────────────────────────
# paper  → simulate orders (no real money)
# live   → execute real orders on the exchange
TRADING_MODE=paper

# ── Active exchange ───────────────────────────────────────────────────────────
ACTIVE_EXCHANGE=bybit   # bybit | binance | kucoin | okx

# ── Bybit ─────────────────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true      # set false for live trading

# ── Binance ───────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ── KuCoin ────────────────────────────────────────────────────────────────────
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# ── OKX ───────────────────────────────────────────────────────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_DRAWDOWN_PCT=0.20       # 20% — halt bot if portfolio drops this much
MAX_DAILY_LOSS_PCT=0.05     # 5%  — halt bot if daily loss exceeds this
MAX_POSITION_SIZE_PCT=0.10  # 10% — max single position as % of portfolio
RISK_PER_TRADE=0.02         # 2%  — risk per individual trade

# ── AI Agent Cluster ──────────────────────────────────────────────────────────
# ALL THREE keys are strongly recommended for maximum capital preservation.
# The bot enforces "triple consensus" — all agents must agree before a trade executes.
#
#  Without Anthropic:   NO AI brain at all. Raw strategy signals execute unfiltered.
#  Without Perplexity:  News blindspot. Claude trades without knowing current events.
#                       (auto-rejected if a major hack/crash is happening)
#  Without Gemini:      Chart blindspot. No technical confirmation of signals.
#
# Get keys at:
#   Anthropic  → https://console.anthropic.com
#   Perplexity → https://www.perplexity.ai/settings/api
#   Gemini     → https://aistudio.google.com/app/apikey

ANTHROPIC_API_KEY=sk-ant-api03-...       # Claude Opus 4.6 — Orchestrator
PERPLEXITY_API_KEY=pplx-...              # Sonar Pro — News & Sentiment Expert
GEMINI_API_KEY=AIzaSy...                 # Gemini 2.5 Pro — Technical Analysis Expert

# ── Strategy toggles ──────────────────────────────────────────────────────────
ENABLE_HFT=true
ENABLE_AI_MULTI=true
ENABLE_ZERO_LOSS=true
ENABLE_GRID=false
ENABLE_GOMALE=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db
