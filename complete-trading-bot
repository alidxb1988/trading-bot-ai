        async function runGomaleBacktest() {
            const capital      = parseFloat(document.getElementById('bt-capital').value) || 1000;
            const timeframe    = document.getElementById('bt-timeframe').value;
            const risk         = parseFloat(document.getElementById('bt-risk').value) || 10;
            const useClaude    = document.getElementById('bt-use-claude').checked;
            const useNews      = document.getElementById('bt-use-news').checked;
            const usePoly      = document.getElementById('bt-use-poly').checked;
            const btn          = document.getElementById('bt-run-btn');

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Running…';
            document.getElementById('bt-results').classList.add('hidden');
            document.getElementById('bt-eth-section').classList.add('hidden');
            _btState.sol = null; _btState.eth = null;

            const payload = {
                starting_capital: capital, timeframe, risk_per_trade: risk,
                confidence_gate: 70, use_claude: useClaude, use_news: useNews,
                use_polymarket: usePoly,
            };

            btLog('Starting multi-source Gomale backtest…', 'info');
            btProgress(5, 'Fetching market data…', 0);

            // Refresh Polymarket sidebar
            btRefreshPolymarkets();

            try {
                btProgress(15, 'Running Claude AI analysis…', 1);
                await new Promise(r => setTimeout(r, 200)); // UI breathing room

                // Run SOL
                btProgress(22, 'Analysing news sentiment (SOL)…', 2);
                await new Promise(r => setTimeout(r, 150));
                btProgress(30, 'Fetching Polymarket odds (SOL)…', 3);
                await new Promise(r => setTimeout(r, 100));
                btProgress(35, 'Backtesting Solana…', 4);

                const solRes = await fetch('/api/backtest/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ...payload, symbol: 'SOL' }),
                });
                if (!solRes.ok) throw new Error(await solRes.text());
                _btState.sol = await solRes.json();
                btProgress(50, 'SOL done – analysing Ethereum…', 1);
                btLog(`SOL: ${_btState.sol.metrics.totalReturn >= 0 ? '+' : ''}${_btState.sol.metrics.totalReturn.toFixed(2)}% return, ${_btState.sol.metrics.winRate.toFixed(1)}% win-rate`, 'success');

                // Run ETH
                btProgress(60, 'Analysing news sentiment (ETH)…', 2);
                await new Promise(r => setTimeout(r, 150));
                btProgress(70, 'Fetching Polymarket odds (ETH)…', 3);
                await new Promise(r => setTimeout(r, 100));
                btProgress(78, 'Backtesting Ethereum…', 4);

                const ethRes = await fetch('/api/backtest/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ...payload, symbol: 'ETH' }),
                });
                if (!ethRes.ok) throw new Error(await ethRes.text());
                _btState.eth = await ethRes.json();
                btProgress(100, 'Complete!', 5);
                btLog(`ETH: ${_btState.eth.metrics.totalReturn >= 0 ? '+' : ''}${_btState.eth.metrics.totalReturn.toFixed(2)}% return, ${_btState.eth.metrics.winRate.toFixed(1)}% win-rate`, 'success');

                // Log signal sources
                if (_btState.sol.signalBreakdown) {
                    const top = _btState.sol.signalBreakdown.sort((a,b) => b.count - a.count)[0];
                    if (top) btLog(`SOL dominant signal source: ${top.source} (${top.pct}% of signals)`, 'info');
                }

                renderBacktestResults(_btState.sol, 'sol');
                renderBacktestResults(_btState.eth, 'eth');
                renderComparison(_btState.sol, _btState.eth);

                document.getElementById('bt-results').classList.remove('hidden');
                document.getElementById('bt-eth-section').classList.remove('hidden');
                btSwitchTab('individual');
            } catch (err) {
                btLog('Error: ' + err.message, 'error');
                showNotification('Backtest failed: ' + err.message, 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-play"></i> Run Backtest';
            }
        }

