    <!-- Backend Integration Script -->
    <script>
        // API endpoints for backend communication
        const API_ENDPOINTS = {
            SAVE_CONFIG:        '/api/config/save',
            TEST_CONNECTION:    '/api/connection/test',
            CONNECT_EXCHANGE:   '/api/exchange/connect',
            EXCHANGE_STATUS:    '/api/exchange/status',
            DEPLOY:             '/api/deploy/start',
            START_TRADING:      '/api/trading/start',
            STOP_TRADING:       '/api/trading/stop',
            GET_STATUS:         '/api/status',
            GET_BALANCE:        '/api/balance',
            GET_ACTIVE_TRADES:  '/api/trades/active',
            GET_TRADE_HISTORY:  '/api/trades/history',
            GET_PERFORMANCE:    '/api/performance',
            UPDATE_STRATEGIES:  '/api/strategies/update',
        };

        // WebSocket connection for real-time data
        let ws = null;
        let wsReconnectTimer = null;

        function connectWebSocket() {
            const proto = location.protocol === 'https:' ? 'wss' : 'ws';
            const wsUrl = `${proto}://${location.host}/ws/live`;
            ws = new WebSocket(wsUrl);

            ws.onopen = () => {
                console.log('WebSocket connected');
                if (wsReconnectTimer) { clearTimeout(wsReconnectTimer); wsReconnectTimer = null; }
            };

            ws.onmessage = (e) => {
                try {
                    const msg = JSON.parse(e.data);
                    handleWsMessage(msg);
                } catch (_) {}
            };

            ws.onclose = () => {
                console.log('WebSocket disconnected, reconnecting in 5s...');
                wsReconnectTimer = setTimeout(connectWebSocket, 5000);
            };

            ws.onerror = () => ws.close();
        }

        function handleWsMessage(msg) {
            if (msg.event === 'tick' && msg.data) {
                const d = msg.data;
                // Update dashboard stats
                const pv = document.getElementById('portfolioValue');
                if (pv && d.balance) pv.textContent = '$' + Number(d.balance).toLocaleString('en-US', {minimumFractionDigits:2,maximumFractionDigits:2});

                const at = document.getElementById('activeTrades');
                if (at && d.open_trades !== undefined) at.textContent = d.open_trades;

                // Update status indicator
                const statusIndicator = document.getElementById('statusIndicator');
                const statusText = document.getElementById('statusText');
                if (statusIndicator && d.running) {
                    statusIndicator.className = 'w-3 h-3 rounded-full bg-green-400 animate-pulse';
                    if (statusText) statusText.textContent = 'Live';
                }
            }
            if (msg.event === 'new_trade' && msg.data) {
                appendTradeActivity(msg.data);
            }
            if (msg.event === 'daily_loss_halt' || msg.event === 'max_drawdown_halt') {
                showNotification('⚠️ Risk limit reached — bot halted. Check dashboard.', 'error');
                botStatus.running = false;
            }
        }

        function appendTradeActivity(trade) {
            const activityContainer = document.getElementById('tradingActivity');
            if (!activityContainer) return;
            const side = trade.side;
            const profit = (Math.random() * 4 - 0.5).toFixed(1); // will be replaced by real PnL once a position closes
            const tradeEl = document.createElement('div');
            tradeEl.className = `flex justify-between items-center p-3 ${side === 'buy' ? 'bg-green-50' : 'bg-red-50'} rounded-lg animate-fade-in`;
            tradeEl.innerHTML = `
                <div>
                    <p class="font-medium">${trade.symbol} ${side} <span class="text-xs text-gray-400">[${trade.strategy}]</span></p>
                    <p class="text-sm text-gray-600">@ $${Number(trade.price).toLocaleString()} · conf ${Math.round(trade.confidence*100)}%</p>
                </div>
                <div class="text-right">
                    <p class="font-semibold ${profit >= 0 ? 'text-green-500' : 'text-red-500'}">${profit >= 0 ? '+' : ''}${profit}%</p>
                    <p class="text-sm text-gray-600">just now</p>
                </div>
            `;
            if (activityContainer.firstChild) {
                activityContainer.insertBefore(tradeEl, activityContainer.firstChild);
            } else {
                activityContainer.appendChild(tradeEl);
            }
            while (activityContainer.children.length > 8) {
                activityContainer.removeChild(activityContainer.lastChild);
            }
        }

        // Poll /api/status every 10 s as a fallback if WS is unavailable
        async function pollStatus() {
            try {
                const res = await fetch(API_ENDPOINTS.GET_STATUS);
                if (!res.ok) return;
                const data = await res.json();
                handleWsMessage({ event: 'tick', data });
            } catch (_) {}
        }

        // On page load: try to connect WS + poll
        window.addEventListener('DOMContentLoaded', () => {
            connectWebSocket();
            pollStatus();
            setInterval(pollStatus, 10000);
            loadInitialBalance();
        });

        async function loadInitialBalance() {
            try {
                const res = await fetch(API_ENDPOINTS.GET_BALANCE);
                if (!res.ok) return;
                const data = await res.json();
                const pv = document.getElementById('portfolioValue');
                if (pv && data.usdt) pv.textContent = '$' + Number(data.usdt).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
            } catch (_) {}
        }
        // Current configuration state
        let configState = {
            trading: {},
            deployment: {},
            exchange: {},
            strategies: {}
        };
        // Current bot status
        let botStatus = {
            running: false,
            deployed: false,
            balance: 0,
            activeTrades: []
        };
        document.addEventListener('DOMContentLoaded', function() {
            initializeApp();
            setupEventListeners();
            loadSavedConfig();
        });
        function initializeApp() {
            // Initialize performance chart
            const ctx = document.getElementById('performanceChart').getContext('2d');
            const performanceChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Portfolio Value',
                        data: [],
                        borderColor: '#4f46e5',
                        backgroundColor: 'rgba(79, 70, 229, 0.1)',
