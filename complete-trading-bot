                    Perplexity: <b style="color:${s.perplexity_online?'#4ade80':'#f87171'}">${s.perplexity_online?'wired':'offline'}</b> &nbsp;|&nbsp;
                    Gemini: <b style="color:${s.gemini_online?'#4ade80':'#f87171'}">${s.gemini_online?'wired':'offline'}</b> &nbsp;|&nbsp;
                    Last: ${s.last_run_at ? new Date(s.last_run_at).toLocaleTimeString() : 'Never'}
                </div>`;
            const cb = document.getElementById('ag-claude-on');
            if (cb) cb.checked = on;
            if (s.last_reasoning_preview) {
                const re = document.getElementById('ag-claude-reasoning');
                if (re) re.textContent = s.last_reasoning_preview;
            }
            if (s.last_decision && s.last_decision.decisions) {
                _agRenderLastDecision(s.last_decision);
            }
        }

        function _agRenderPerp(s) {
            const el = document.getElementById('ag-perp-status');
            if (!el) return;
            const on = s.enabled;
            el.innerHTML = `
                <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;margin-bottom:0.5rem">
                    <span style="color:${on ? '#4ade80' : '#f87171'};font-weight:600">${on ? '● Online' : '● Offline'}</span>
                    ${_agKeyBadge(on, 'PERPLEXITY_API_KEY')}
                </div>
                ${!on ? `<div style="color:#fbbf24;font-size:0.75rem;margin-bottom:0.3rem">&#x26A0; No news data — Claude applies extra caution on buys</div>` : ''}
                <div style="color:var(--text-secondary);font-size:0.72rem">
                    Calls: ${s.total_calls||0} | Errors: ${s.total_errors||0} |
                    Cached: ${(s.cached_symbols||[]).join(', ')||'none'}
                </div>`;
        }

        function _agRenderGem(s) {
            const el = document.getElementById('ag-gem-status');
            if (!el) return;
            const on = s.enabled;
            el.innerHTML = `
                <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;margin-bottom:0.5rem">
                    <span style="color:${on ? '#4ade80' : '#f87171'};font-weight:600">${on ? '● Online' : '● Offline'}</span>
                    ${_agKeyBadge(on, 'GEMINI_API_KEY')}
                    ${on ? `<span style="background:#0891b222;color:#22d3ee;padding:0.15rem 0.4rem;border-radius:3px;font-size:0.7rem">${s.model||'gemini-2.5-pro'}</span>` : ''}
                </div>
                ${!on ? `<div style="color:#fbbf24;font-size:0.75rem;margin-bottom:0.3rem">&#x26A0; No chart analysis — Claude applies extra caution on signals</div>` : ''}
                <div style="color:var(--text-secondary);font-size:0.72rem">
                    Calls: ${s.total_calls||0} | Errors: ${s.total_errors||0} |
                    Cached: ${(s.cached_symbols||[]).join(', ')||'none'}
                </div>`;
        }

        function _agRenderLastDecision(decision) {
            const el = document.getElementById('ag-claude-last-decision');
            if (!el || !decision.decisions) return;
            const rows = decision.decisions.map(d => {
                const col = d.action === 'approve' ? '#4ade80' : d.action === 'reject' ? '#f87171' : '#facc15';
                return `<tr>
                    <td style="padding:0.25rem 0.5rem">${d.symbol}</td>
                    <td style="padding:0.25rem 0.5rem;color:${col};font-weight:600">${d.action.toUpperCase()}</td>
                    <td style="padding:0.25rem 0.5rem">${d.side?.toUpperCase() || ''}</td>
                    <td style="padding:0.25rem 0.5rem">${((d.confidence||0)*100).toFixed(0)}%</td>
                    <td style="padding:0.25rem 0.5rem;color:var(--text-secondary);font-size:0.75rem">${d.reason || ''}</td>
                </tr>`;
            }).join('');
            el.innerHTML = `
                <div style="font-size:0.8rem;font-weight:600;margin-bottom:0.4rem;color:var(--text-secondary)">
                    Last decisions — risk: <b style="color:${decision.risk_level==='high'?'#f87171':decision.risk_level==='medium'?'#facc15':'#4ade80'}">${decision.risk_level || 'unknown'}</b>
                </div>
                <div style="overflow-x:auto">
                <table style="width:100%;border-collapse:collapse;font-size:0.8rem">
                    <thead><tr style="color:var(--text-secondary)">
                        <th style="padding:0.25rem 0.5rem;text-align:left">Symbol</th>
                        <th style="padding:0.25rem 0.5rem;text-align:left">Action</th>
                        <th style="padding:0.25rem 0.5rem;text-align:left">Side</th>
                        <th style="padding:0.25rem 0.5rem;text-align:left">Conf</th>
                        <th style="padding:0.25rem 0.5rem;text-align:left">Reason</th>
                    </tr></thead>
                    <tbody>${rows}</tbody>
                </table></div>
                <div style="margin-top:0.4rem;font-size:0.78rem;color:var(--text-secondary);font-style:italic">${decision.portfolio_notes || ''}</div>`;
        }

        async function agentsToggleClaude(enabled) {
            try {
                await fetch('/api/brain/toggle', {
                    method: 'POST',
                    headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({enabled})
                });
            } catch(e) { console.warn('Toggle failed:', e); }
        }

        async function agentsRunNews(symbol) {
            const loading = document.getElementById('ag-news-loading');
            const results = document.getElementById('ag-news-results');
            if (loading) loading.style.display = 'block';
            if (results) results.innerHTML = '';
            try {
                const symbols = symbol ? [symbol] : ['BTC/USDT','ETH/USDT','SOL/USDT'];
                const data = await fetch('/api/brain/news', {
                    method: 'POST',
                    headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({symbols})
                }).then(r => r.json());

                if (loading) loading.style.display = 'none';
                const res = data.results || {};
                if (!results) return;
                results.innerHTML = Object.entries(res).map(([sym, d]) => {
                    const score = (d.score || 0);
                    const scoreColor = score > 0.2 ? '#4ade80' : score < -0.2 ? '#f87171' : '#facc15';
                    const sentColor = d.sentiment === 'BULLISH' ? '#4ade80' : d.sentiment === 'BEARISH' ? '#f87171' : '#facc15';
                    const headlines = (d.headlines || []).map(h => `<li style="margin-left:1rem;list-style:disc">${h}</li>`).join('');
                    const events = (d.key_events || []).map(e =>
                        `<span style="background:#ffffff11;padding:0.15rem 0.4rem;border-radius:3px;font-size:0.7rem">${e}</span>`
                    ).join(' ');
                    return `<div style="background:var(--card-bg);border:1px solid var(--border);border-radius:6px;padding:0.75rem">
                        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:0.5rem">
                            <b style="font-size:0.9rem">${sym}</b>
                            <span style="color:${sentColor};font-weight:600">${d.sentiment || 'NEUTRAL'}</span>
                            <span style="color:${scoreColor}">Score: ${score.toFixed(2)}</span>
                            <span style="color:var(--text-secondary);font-size:0.75rem">conf: ${((d.confidence||0)*100).toFixed(0)}%</span>
                            <span style="color:var(--text-secondary);font-size:0.75rem">${d.impact_estimate || ''}</span>
                        </div>
                        ${headlines ? `<ul style="font-size:0.8rem;color:var(--text-secondary);margin-bottom:0.4rem">${headlines}</ul>` : ''}
                        ${events ? `<div style="margin-bottom:0.4rem;display:flex;gap:0.3rem;flex-wrap:wrap">${events}</div>` : ''}
                        <div style="font-size:0.78rem;color:var(--text-secondary);font-style:italic">${d.summary || ''}</div>
                    </div>`;
                }).join('') || '<div style="color:var(--text-secondary);font-size:0.85rem">No results returned.</div>';
            } catch(e) {
                if (loading) loading.style.display = 'none';
                if (results) results.innerHTML = `<div style="color:#f87171;font-size:0.85rem">Error: ${e.message}. Make sure PERPLEXITY_API_KEY is set in .env</div>`;
            }
        }

        async function agentsRunGemini() {
            const sym = document.getElementById('ag-gem-symbol')?.value || 'BTC/USDT';
            document.getElementById('ag-gem-symbol2') && (document.getElementById('ag-gem-symbol2').value = sym);
            await _agRunGeminiForSymbol(sym);
        }

        async function agentsRunGemini2() {
            const sym = document.getElementById('ag-gem-symbol2')?.value || 'BTC/USDT';
            await _agRunGeminiForSymbol(sym);
        }

        async function _agRunGeminiForSymbol(symbol) {
            const loading = document.getElementById('ag-gem-loading');
            const results = document.getElementById('ag-gem-results');
            const notes   = document.getElementById('ag-gem-notes');
            if (loading) loading.style.display = 'inline';
            if (results) results.innerHTML = '';
            if (notes)   notes.textContent = '';
            try {
                const data = await fetch('/api/brain/analyze', {
                    method: 'POST',
                    headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({symbol})
                }).then(r => r.json());
                if (loading) loading.style.display = 'none';
                _agRenderGeminiResult(data);
            } catch(e) {
                if (loading) loading.style.display = 'none';
                if (results) results.innerHTML = `<div style="color:#f87171;font-size:0.85rem;grid-column:1/-1">Error: ${e.message}. Make sure GEMINI_API_KEY is set in .env</div>`;
            }
        }

        function _agRenderGeminiResult(d) {
            const results = document.getElementById('ag-gem-results');
            const notes   = document.getElementById('ag-gem-notes');
            if (!results) return;

            const trend   = d.trend || {};
            const mom     = d.momentum || {};
            const vol     = d.volatility || {};
            const fc      = d.forecast || {};
            const ratingColor = {strong_buy:'#4ade80',buy:'#86efac',neutral:'#facc15',sell:'#fca5a5',strong_sell:'#f87171'};

            const trendIcon = t => t === 'bullish' ? '&#x2191;' : t === 'bearish' ? '&#x2193;' : '&#x2194;';
            const trendColor = t => t === 'bullish' ? '#4ade80' : t === 'bearish' ? '#f87171' : '#facc15';

            const patterns = (d.patterns || []).slice(0, 3).map(p =>
                `<span style="background:${p.type==='bullish'?'#16a34a33':p.type==='bearish'?'#dc262633':'#71717a33'};
                color:${p.type==='bullish'?'#4ade80':p.type==='bearish'?'#f87171':'#a1a1aa'};
                padding:0.15rem 0.4rem;border-radius:3px;font-size:0.7rem;margin:0.1rem;display:inline-block"
                >${p.name} (${((p.confidence||0)*100).toFixed(0)}%)</span>`
            ).join('');

            results.innerHTML = `
                <div style="background:var(--card-bg);border:1px solid var(--border);border-radius:6px;padding:0.75rem">
                    <div style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.25rem">Overall Rating</div>
                    <div style="font-size:1.1rem;font-weight:700;color:${ratingColor[d.overall_rating]||'#facc15'}">${(d.overall_rating||'neutral').replace('_',' ').toUpperCase()}</div>
                    <div style="font-size:0.75rem;color:var(--text-secondary);margin-top:0.25rem">${d.symbol || ''}</div>
                </div>
                <div style="background:var(--card-bg);border:1px solid var(--border);border-radius:6px;padding:0.75rem">
                    <div style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.4rem">Trend Alignment: <b style="color:${trend.alignment==='aligned'?'#4ade80':'#facc15'}">${trend.alignment||'?'}</b></div>
                    <div style="display:flex;flex-direction:column;gap:0.2rem;font-size:0.8rem">
                        <span>Short: <span style="color:${trendColor(trend.short_term)}">${trendIcon(trend.short_term)} ${trend.short_term||'?'}</span></span>
                        <span>Mid: <span style="color:${trendColor(trend.medium_term)}">${trendIcon(trend.medium_term)} ${trend.medium_term||'?'}</span></span>
                        <span>Long: <span style="color:${trendColor(trend.long_term)}">${trendIcon(trend.long_term)} ${trend.long_term||'?'}</span></span>
                    </div>
                </div>
                <div style="background:var(--card-bg);border:1px solid var(--border);border-radius:6px;padding:0.75rem">
                    <div style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.4rem">Momentum</div>
                    <div style="font-size:0.8rem;display:flex;flex-direction:column;gap:0.2rem">
                        <span>RSI: <b>${(mom.rsi_estimate||50).toFixed(0)}</b></span>
                        <span>MACD: <b style="color:${mom.macd_signal==='bullish'?'#4ade80':mom.macd_signal==='bearish'?'#f87171':'#facc15'}">${mom.macd_signal||'neutral'}</b></span>
                        <span>Volume: <b>${mom.volume_trend||'flat'}</b></span>
                    </div>
                </div>
                <div style="background:var(--card-bg);border:1px solid var(--border);border-radius:6px;padding:0.75rem">
                    <div style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.4rem">Forecast (1-4h)</div>
                    <div style="font-size:1rem;font-weight:600;color:${fc.direction==='up'?'#4ade80':fc.direction==='down'?'#f87171':'#facc15'}">
                        ${fc.direction==='up'?'&#x2191;':fc.direction==='down'?'&#x2193;':'&#x2194;'} ${fc.direction||'sideways'}
                    </div>
                    <div style="font-size:0.78rem;color:var(--text-secondary)">conf: ${((fc.confidence||0)*100).toFixed(0)}% | range: ±${fc.expected_range_pct||0}%</div>
                </div>
                <div style="background:var(--card-bg);border:1px solid var(--border);border-radius:6px;padding:0.75rem;grid-column:1/-1">
                    <div style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:0.4rem">Patterns Detected</div>
                    ${patterns || '<span style="font-size:0.8rem;color:var(--text-secondary)">None detected</span>'}
                </div>`;

            if (notes && d.analyst_notes) notes.textContent = '&#x1F4CA; ' + d.analyst_notes;
        }

        // Auto-refresh agents panel when tab is opened
        document.addEventListener('DOMContentLoaded', () => {
            const agentsTab = document.querySelector('[data-target="agents"]');
            if (agentsTab) {
                agentsTab.addEventListener('click', () => {
                    agentsRefresh();
                }, { once: false });
            }
        });

        // ── End AI Agents ─────────────────────────────────────────────────────

        // Add CSS for fade-in animation
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }
            .animate-fade-in {
                animation: fadeIn 0.3s ease-out;
            }
        `;
        document.head.appendChild(style);
    </script>
</body>
</html>
